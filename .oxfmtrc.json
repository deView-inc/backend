{
  "lineWidth": 100,
  "indentWidth": 4,
  "useTabs": false,
  "quoteStyle": "single",
  "trailingCommas": "all",
  "semicolons": true,
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "singleAttributePerLine": true,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false
}
