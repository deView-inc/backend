<html lang='ru' xmlns:o='urn:schemas-microsoft-com:office:office'>
    <head>
        <meta charset='utf-8' />
        <meta name='viewport' content='width=device-width,initial-scale=1' />
        <meta name='x-apple-disable-message-reformatting' />
        <meta name='color-scheme' content='dark' />
        <meta name='supported-color-schemes' content='dark' />
        <title>deView — Код подтверждения входа</title>
        <!--
  ============================================================
  01 · ПОДТВЕРЖДЕНИЕ ВХОДА (OTP)
  Тема:      Код подтверждения входа — {{ code }}
  От:        deView <no-reply@deview.dev>
  Прехедер:  Код действует {{ code_ttl_minutes }} минут

    {{ assets_base_url }}          — АБСОЛЮТНЫЙ URL папки с иконками, без слэша на конце:
                                    напр. https://cdn.deview.dev/mail — файлы лежат в ./icons

  ПЕРЕМЕННЫЕ:
    {{ title }}                     — тема письма
    {{ description }}
    {{ badge_text }}
    {{ code }}                      — код, 6 цифр, строкой: 418302
    {{ confirm_url }}               — ссылка «Подтвердить вход» (magic-link)
    {{ help_url }}                  — ссылка на помощь
    {{ notification_settings_url }} — настройки уведомлений
    {{ year }}                      — текущий год: 2026
  ============================================================
-->
        <!--[if mso]><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml><![endif]-->
        <link
            href='https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap'
            rel='stylesheet'
        />
        <style>
            body,
            table,
            td,
            a {
                -webkit-text-size-adjust: 100%;
                -ms-text-size-adjust: 100%;
            }
            table,
            td {
                mso-table-lspace: 0pt;
                mso-table-rspace: 0pt;
            }
            img {
                border: 0;
                outline: none;
                text-decoration: none;
                -ms-interpolation-mode: bicubic;
            }
            a {
                color: #b9f24c;
            }
            @media only screen and (max-width: 620px) {
                .wrap {
                    width: 100% !important;
                }
                .px {
                    padding-left: 18px !important;
                    padding-right: 18px !important;
                }
                .code {
                    font-size: 30px !important;
                    letter-spacing: 0.16em !important;
                }
            }
            .digit {
                padding: 15px;
                border: 1px solid #1c2026;
                border-radius: 8px;
                text-align: center;
                letter-spacing: 0;
            }
        </style>
    </head>
    <body style='margin:0;padding:0;background:#07080A;'>

        <!-- прехедер: первая строка в списке писем -->
        <div
            style='display:none;font-size:1px;color:#07080A;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;'
        >Код действует
            {{code_ttl_minutes}}
            минут&#8199;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;</div>

        <table
            role='presentation'
            width='100%'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='background:#07080A;'
        >
            <tr><td align='center' style='padding:32px 12px 40px;'>

                    <table
                        role='presentation'
                        class='wrap'
                        width='600'
                        cellpadding='0'
                        cellspacing='0'
                        border='0'
                        style='width:600px;max-width:600px;background:#0C0E11;border:1px solid #1c2026;border-radius:14px;overflow:hidden;'
                    >

                        <!-- ШАПКА -->
                        <tr><td
                                class='px'
                                style='padding:18px 24px;background:#101215;border-bottom:1px solid #17191d;'
                            >
                                <table
                                    role='presentation'
                                    width='100%'
                                    cellpadding='0'
                                    cellspacing='0'
                                    border='0'
                                ><tr>
                                        <td width='26' valign='middle' style='width:26px;'>
                                            <table
                                                role='presentation'
                                                cellpadding='0'
                                                cellspacing='0'
                                                border='0'
                                            ><tr>
                                                    <td
                                                        width='26'
                                                        height='26'
                                                        align='center'
                                                        valign='middle'
                                                        bgcolor='#B9F24C'
                                                        style="width:26px;height:26px;line-height:26px;background:#B9F24C;border-radius:8px;font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,'Courier New',monospace;font-size:13px;font-weight:700;color:#0A0C0E;"
                                                    ><img
                                                            src='cid:terminal-window'
                                                            width='15'
                                                            height='15'
                                                            alt='&gt;_'
                                                            style='display:block;margin:0 auto;border:0;'
                                                        /></td>
                                                </tr></table>
                                        </td>
                                        <td
                                            valign='middle'
                                            style="padding-left:10px;font-family:'Space Grotesk',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:15px;font-weight:700;letter-spacing:-.01em;color:#E7EAED;white-space:nowrap;"
                                        >deView</td>
                                        <td
                                            valign='middle'
                                            align='right'
                                            style="font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,'Courier New',monospace;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:#626A73;"
                                        >безопасность аккаунта</td>
                                    </tr></table>
                            </td></tr>

                        <!-- ТЕЛО -->
                        <tr><td class='px' style='padding:30px 24px 32px;'>

                                <!-- плашка категории -->
                                <table
                                    role='presentation'
                                    cellpadding='0'
                                    cellspacing='0'
                                    border='0'
                                    style='margin-bottom:20px;'
                                ><tr>
                                        <td
                                            style='background:#1D2517;border:1px solid #3C4E22;border-radius:100px;padding:5px 12px;'
                                        >
                                            <table
                                                role='presentation'
                                                cellpadding='0'
                                                cellspacing='0'
                                                border='0'
                                            ><tr>
                                                    <td
                                                        valign='middle'
                                                        style='padding-right:7px;font-size:0;line-height:0;'
                                                    ><img
                                                            src='cid:sign-in'
                                                            width='13'
                                                            height='13'
                                                            alt=''
                                                            style='display:block;border:0;position:relative;top:-1px;'
                                                        /></td>
                                                    <td
                                                        valign='middle'
                                                        style="font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,'Courier New',monospace;font-size:11px;line-height:11px;mso-line-height-rule:exactly;color:#B9F24C;"
                                                    >{{badge_text}}</td>
                                                </tr></table>
                                        </td>
                                    </tr></table>

                                <h1
                                    style="margin:0 0 12px;font-family:'Space Grotesk',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:23px;font-weight:600;letter-spacing:-.02em;line-height:1.25;color:#E7EAED;"
                                >{{title}}</h1>

                                <p
                                    style="margin:0 0 24px;font-family:'Space Grotesk',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:15px;line-height:1.6;color:#98A0A8;"
                                >{{description}}</p>

                                <!-- блок с кодом -->
                                <table
                                    role='presentation'
                                    width='100%'
                                    cellpadding='0'
                                    cellspacing='0'
                                    border='0'
                                    style='background:#0A0B0D;border:1px solid #23272E;border-radius:12px;margin-bottom:22px;'
                                ><tr>
                                        <td align='center' style='padding:22px 16px;'>
                                            <div
                                                style="font-family:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#626A73;text-align:center;padding-bottom:16px;"
                                            >код подтверждения</div>

                                            <div
                                                style='text-align:center;font-size:0;line-height:0;'
                                            >
                                                {{#each code}}<span
                                                        style="display:inline-block;width:44px;height:56px;line-height:56px;margin:0 4px;background-color:#0f1216;border:1px solid #1c2026;border-radius:8px;font-family:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;font-size:32px;font-weight:700;color:#B9F24C;text-align:center;vertical-align:middle;letter-spacing:0;box-sizing:border-box;"
                                                    >{{this}}</span>{{/each}}
                                            </div>
                                        </td>
                                    </tr></table>

                                <!-- кнопка -->
                                <table
                                    role='presentation'
                                    width='100%'
                                    cellpadding='0'
                                    cellspacing='0'
                                    border='0'
                                    style='margin-bottom:18px;'
                                ><tr>
                                        <td
                                            align='center'
                                            bgcolor='#B9F24C'
                                            style='background:#B9F24C;border-radius:11px;padding:14px 20px;'
                                        >
                                            <a
                                                href='{{confirm_url}}'
                                                style="display:block;font-family:'Space Grotesk',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:15px;font-weight:600;line-height:1.2;color:#0A0C0E;text-decoration:none;"
                                            >Подтвердить вход</a>
                                        </td>
                                    </tr></table>

                                <p
                                    style="margin:0;font-family:'Space Grotesk',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:13.5px;line-height:1.6;color:#626A73;"
                                >Если вы не запрашивали вход, просто проигнорируйте это письмо. Не
                                    передавайте код третьим лицам — сотрудники deView никогда его не
                                    запрашивают.</p>

                            </td></tr>

                        <!-- ПОДВАЛ -->
                        <tr><td
                                class='px'
                                style="padding:18px 24px 22px;background:#0A0B0D;border-top:1px solid #17191d;font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,'Courier New',monospace;font-size:11px;line-height:1.75;color:#4d555e;"
                            >
                                deView · сервис технических интервью<br />
                                Письмо отправлено автоматически, отвечать на него не нужно.<br />
                                <a
                                    href='{{help_url}}'
                                    style='color:#626A73;text-decoration:underline;'
                                >Помощь</a>
                                &middot;
                                <a
                                    href='{{notification_settings_url}}'
                                    style='color:#626A73;text-decoration:underline;'
                                >Настройки уведомлений</a><br />
                                &copy;
                                {{year}}
                                deView
                            </td></tr>

                    </table>

                </td></tr></table>
    </body>
</html>